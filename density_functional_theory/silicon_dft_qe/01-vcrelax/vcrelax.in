&CONTROL
  calculation = 'vc-relax'
  etot_conv_thr =   2.0d-05
  forc_conv_thr =   1.0d-04
  outdir = 'tmp'
  prefix = 'si'
  pseudo_dir = '../pseudo/'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
/
&SYSTEM
  ecutrho =   240
  ecutwfc =   30
  ibrav = 0
  nat = 2
  nosym = .false.
  ntyp = 1
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr =   4.0d-10
  electron_maxstep = 80
  mixing_beta =   0.4
/
&IONS
/
&CELL
    press_conv_thr= 0.002
    cell_dofree = 'ibrav'
/

ATOMIC_SPECIES
Si     28.0855 Si.pbesol-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS (crystal)
Si           0.0000000000       0.0000000000       0.0000000000
Si           0.2500000000       0.2500000000       0.2500000000

CELL_PARAMETERS (angstrom)
      2.7154800000       2.7154800000       0.0000000000
      2.7154800000       0.0000000000       2.7154800000
      0.0000000000       2.7154800000       2.7154800000

